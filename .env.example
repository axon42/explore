# Local development only. Never expose these servers publicly or through tunnels.
DATA_DIR=./data
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEMO_ENABLED=true
# Optional shared producer secret. Never prefix this with VITE_.
INGESTION_TOKEN=
SUBSCRIBER_QUEUE_SIZE=128

# Default: deterministic simulated questions, no network or API charges.
ANALYSIS_PROVIDER=mock
# Initial fallback only. The bottom-left Analysis mode control persists later choices.
ANALYSIS_STRATEGY=legacy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Hard call-count cap per session, including failures; not a dollar budget.
ANALYSIS_MAX_CALLS=100

# Bounded overall deadline; free-tier generation can exceed 20 seconds.
ANALYSIS_TIMEOUT_SECONDS=45

# Zoom account proof only; opt-in. Never use VITE_ for credentials.
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=
ZOOM_PROOF_ENABLED=false
# Zoom Add feature > Secret Token; distinct from SDK Secret.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Optional macOS microphone + system audio capture (Deepgram, independent of Gemini).
DEEPGRAM_API_KEY=
# Maximum wall-clock duration per capture. Two mono streams; one capture at a time.
# 0 = manual stop; an optional test cutoff can be 30–600 seconds.
AUDIO_CAPTURE_MAX_SECONDS=0
